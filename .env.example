# Local development only. Never commit real values to this file.
APP_ENV=development
DATABASE_URL=sqlite:///./prism_link.db
JWT_SECRET_KEY=replace-with-a-long-random-local-development-secret
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-different-long-random-local-development-secret
PUBLIC_BASE_URL=http://localhost:8000
REDIS_URL=redis://localhost:6379/0
RECORD_CALLS=false

# Calendar. Use mock for provider-free local development.
CALENDAR_PROVIDER=mock
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/calendar/google/callback
CREDENTIAL_STORE_PATH=.secrets

# Add provider keys only in your private, ignored .env file.
# DEEPGRAM_API_KEY=
# GROQ_API_KEY=
# OPENROUTER_API_KEY=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Voice development defaults.
LLM_PROVIDER=groq
VOICE_TENANT_SLUG=
VOICE_TEST_CALLER_NUMBER=0210000000
DEEPGRAM_STT_MODEL=nova-3-general
DEEPGRAM_STT_LANGUAGE=en-NZ
DEEPGRAM_TTS_VOICE=aura-2-helena-en
GROQ_FAST_MODEL=openai/gpt-oss-20b
GROQ_REASONING_MODEL=openai/gpt-oss-120b
GROQ_REASONING_EFFORT=low
OPENROUTER_MODEL=openrouter/free

# FreeSWITCH media WebSocket listener. Keep loopback unless protected by a token and private TLS.
FS_WS_HOST=127.0.0.1
FS_WS_PORT=8765
FS_SAMPLE_RATE=16000
FS_MAX_CALLS=10
FS_RECEIVE_TIMEOUT=60
FS_SEND_TIMEOUT=2
FS_WS_TOKEN=

# Aurora local SIP/RTP edge. The control API and event callback must stay on loopback.
AURORA_CONTROL_API_URL=http://127.0.0.1:8088
# Set to the same secret as PRISMLINK_API_TOKEN in Aurora's systemd environment.
# AURORA_CONTROL_API_TOKEN=
# Set to Aurora settings.json local_ip (not external_ip); the Pipecat AI socket stays on loopback.
# AURORA_RTP_HOST=192.168.1.26
AURORA_RTP_BIND_HOST=127.0.0.1
AURORA_STARTUP_TIMEOUT_SECONDS=20
AURORA_MAX_ACTIVE_CALLS=8
